---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="今週の新刊漫画をまとめて紹介。期待値・話題性を独自分析。" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="漫画新刊まとめ" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen font-sans antialiased">
    <header class="sticky top-0 z-50 backdrop-blur-xl bg-white/80 border-b border-gray-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 sm:py-4 flex items-center justify-between">
        <a href="/" class="group flex items-center gap-2">
          <span class="text-xl sm:text-2xl">📚</span>
          <span class="text-base sm:text-lg font-bold bg-gradient-to-r from-violet-600 to-pink-600 bg-clip-text text-transparent group-hover:from-violet-500 group-hover:to-pink-500 transition-all">
            漫画新刊まとめ
          </span>
        </a>
        <nav class="flex items-center gap-3 sm:gap-4 text-sm">
          <a href="/sales" class="text-rose-500 hover:text-rose-600 font-medium transition-colors">セール</a>
          <a href="/ranking" class="text-gray-500 hover:text-violet-600 transition-colors">ランキング</a>
          <a href="/calendar" class="text-gray-500 hover:text-violet-600 transition-colors max-sm:hidden">カレンダー</a>
          <a href="/series" class="text-gray-500 hover:text-violet-600 transition-colors max-sm:hidden">シリーズ</a>
          <a href="/tags" class="text-gray-500 hover:text-violet-600 transition-colors max-sm:hidden">タグ</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="border-t border-gray-200 mt-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
        <div class="flex flex-wrap justify-center gap-4 sm:gap-6 text-sm text-gray-400 mb-4">
          <a href="/" class="hover:text-violet-600 transition-colors">ホーム</a>
          <a href="/sales" class="hover:text-rose-500 transition-colors">セール</a>
          <a href="/ranking" class="hover:text-violet-600 transition-colors">ランキング</a>
          <a href="/calendar" class="hover:text-violet-600 transition-colors">カレンダー</a>
          <a href="/series" class="hover:text-violet-600 transition-colors">シリーズ</a>
          <a href="/tags" class="hover:text-violet-600 transition-colors">タグ</a>
          <a href="/rss.xml" class="hover:text-violet-600 transition-colors">RSS</a>
        </div>
        <div class="text-center text-gray-400 text-sm space-y-1">
          <p>※ 当サイトはAmazonアソシエイトプログラムに参加しています。</p>
          <p>&copy; 2024 漫画新刊まとめ</p>
        </div>
      </div>
    </footer>
  </body>
</html>
