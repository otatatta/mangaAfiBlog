---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const mangaEntries = await getCollection("manga");
  return mangaEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const allManga = await getCollection("manga");

// 関連作品: 同ジャンルまたは同著者（自分自身を除く、最大4件）
const related = allManga
  .filter((m) => m.slug !== entry.slug && (m.data.genre === entry.data.genre || m.data.author_name === entry.data.author_name))
  .sort((a, b) => {
    const aScore = (a.data.genre === entry.data.genre ? 1 : 0) + (a.data.author_name === entry.data.author_name ? 2 : 0);
    const bScore = (b.data.genre === entry.data.genre ? 1 : 0) + (b.data.author_name === entry.data.author_name ? 2 : 0);
    return bScore - aScore;
  })
  .slice(0, 4);

const buzzLabel = (level: string) => {
  switch (level) {
    case "高": return { color: "bg-rose-100 text-rose-700 border-rose-200", icon: "🔥", text: "話題沸騰" };
    case "中": return { color: "bg-amber-100 text-amber-700 border-amber-200", icon: "📈", text: "注目" };
    default:  return { color: "bg-gray-100 text-gray-600 border-gray-200", icon: "📖", text: "チェック" };
  }
};

const pageUrl = `${Astro.site || "https://example.com"}manga/${entry.slug}/`;
const shareText = `${entry.data.title} | 漫画新刊まとめ`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Review",
  "itemReviewed": {
    "@type": "Book",
    "name": entry.data.title,
    "author": { "@type": "Person", "name": entry.data.author_name },
    "publisher": { "@type": "Organization", "name": entry.data.publisher },
    "datePublished": entry.data.pubDate,
  },
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": entry.data.expectation_score,
    "bestRating": 5,
  },
  "author": { "@type": "Organization", "name": "漫画新刊まとめ" },
};

// こんな方におすすめ 自動生成
const genreRecommendations: Record<string, string[]> = {
  "ファンタジー": ["ファンタジー作品が好きな方", "壮大な世界観の物語を楽しみたい方", "魔法や冒険にワクワクする方"],
  "異世界": ["異世界転生・転移作品が好きな方", "チート能力や成長要素が好きな方", "現実逃避したい時に読みたい方"],
  "アクション": ["迫力のバトルシーンが好きな方", "熱い展開に燃える方", "手に汗握る戦闘を楽しみたい方"],
  "ラブコメ": ["甘酸っぱい恋愛が好きな方", "ニヤニヤしたい方", "青春の空気感を味わいたい方"],
  "ダークファンタジー": ["重厚なストーリーが好きな方", "ダークな世界観に惹かれる方", "善悪の境界が曖昧な物語を楽しめる方"],
  "スポーツ": ["スポーツ観戦が好きな方", "努力と根性の物語に感動する方", "チームプレーの熱さを感じたい方"],
  "ミステリー": ["謎解きが好きな方", "伏線回収にゾクゾクする方", "考察しながら読むのが楽しい方"],
  "SF": ["SF・近未来設定が好きな方", "科学や技術に興味がある方", "知的好奇心を刺激されたい方"],
  "ホラー": ["怖い話が好きな方", "非日常的なスリルを味わいたい方", "独特の雰囲気を楽しめる方"],
  "日常系": ["ほのぼのした作品で癒されたい方", "日常の中の小さな幸せを感じたい方", "気軽に読める漫画を探している方"],
  "歴史": ["歴史が好きな方", "壮大なスケールの物語を楽しみたい方", "実際の歴史を漫画で学びたい方"],
  "グルメ": ["料理や食べ物が好きな方", "読むとお腹が空く漫画を楽しみたい方", "食の知識を広げたい方"],
  "医療": ["医療ドラマが好きな方", "人間の体の仕組みに興味がある方", "命の尊さを感じる物語を読みたい方"],
  "恋愛": ["純粋な恋愛ストーリーが好きな方", "感情移入できる物語を求めている方", "心に響く物語を読みたい方"],
  "文化系": ["文化や芸術に興味がある方", "知的な漫画を楽しみたい方", "新しいジャンルの知識を得たい方"],
};

const tagRecommendations: Record<string, string> = {
  "アニメ化": "アニメから入って原作も読みたい方",
  "転生": "転生ものが好きな方",
  "バトル": "ド派手なバトルが見たい方",
  "コメディ": "笑える漫画を探している方",
  "名作": "名作と呼ばれる作品を押さえたい方",
  "原作小説": "原作小説と合わせて楽しみたい方",
  "青春": "青春時代を追体験したい方",
  "長期連載": "長く楽しめるシリーズを探している方",
  "完結": "完結済みの作品を一気読みしたい方",
};

const recommendations: string[] = [];

// ジャンルベースのおすすめ
const genreRecs = genreRecommendations[entry.data.genre];
if (genreRecs) recommendations.push(...genreRecs);

// タグベースの追加おすすめ
for (const tag of entry.data.tags) {
  const rec = tagRecommendations[tag];
  if (rec && !recommendations.includes(rec)) recommendations.push(rec);
}

// 期待度が高い場合
if (entry.data.expectation_score >= 5) {
  recommendations.push("今最も注目されている作品を読みたい方");
}

// 最大6件に制限
const finalRecommendations = recommendations.slice(0, 6);
---

<BaseLayout title={`${entry.data.title} | 漫画新刊まとめ`}>
  <Fragment slot="head">
    <meta property="og:title" content={entry.data.title} />
    <meta property="og:description" content={entry.data.description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={pageUrl} />
    {entry.data.cover_image && <meta property="og:image" content={entry.data.cover_image} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={entry.data.title} />
    <meta name="twitter:description" content={entry.data.description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-xs text-gray-400 mb-6 flex-wrap">
      <a href="/" class="hover:text-violet-600 transition-colors">ホーム</a>
      <span>/</span>
      <a href={`/tags/${encodeURIComponent(entry.data.genre)}`} class="hover:text-violet-600 transition-colors">{entry.data.genre}</a>
      <span>/</span>
      <span class="text-gray-600">{entry.data.title}</span>
    </nav>

    <!-- Header -->
    <header class="mb-10">
      <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 mb-6">
        {entry.data.cover_image && (
          <div class="shrink-0">
            <img src={entry.data.cover_image} alt={entry.data.title} class="w-32 md:w-40 h-auto object-cover rounded-xl shadow-md" />
          </div>
        )}
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-3 flex-wrap">
            <span class="text-xs font-medium bg-violet-100 text-violet-700 border border-violet-200 px-2.5 py-1 rounded-full">
              {entry.data.genre}
            </span>
            <span class={`text-xs font-medium border px-2.5 py-1 rounded-full ${buzzLabel(entry.data.buzz_level).color}`}>
              {buzzLabel(entry.data.buzz_level).icon} {buzzLabel(entry.data.buzz_level).text}
            </span>
            {/* Bookmark button */}
            <button
              class="bookmark-btn ml-auto text-gray-300 hover:text-rose-500 transition-colors text-xl"
              data-slug={entry.slug}
              data-title={entry.data.title}
              aria-label="お気に入りに追加"
            >
              ♥
            </button>
          </div>

          <h1 class="text-xl sm:text-2xl md:text-3xl font-bold mb-3 bg-gradient-to-r from-violet-600 to-pink-600 bg-clip-text text-transparent">
            {entry.data.title}
          </h1>

          <p class="text-gray-500 text-sm sm:text-base mb-3">{entry.data.description}</p>

          {/* Reading status */}
          <div class="flex gap-2" id="reading-status" data-slug={entry.slug}>
            <button data-status="want" class="status-btn text-xs border border-gray-200 px-3 py-1.5 rounded-full hover:border-violet-300 transition-all">
              📖 読みたい
            </button>
            <button data-status="reading" class="status-btn text-xs border border-gray-200 px-3 py-1.5 rounded-full hover:border-violet-300 transition-all">
              📕 読書中
            </button>
            <button data-status="done" class="status-btn text-xs border border-gray-200 px-3 py-1.5 rounded-full hover:border-violet-300 transition-all">
              ✅ 読了
            </button>
          </div>
        </div>
      </div>

      <!-- Meta -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <a href={`/authors/${encodeURIComponent(entry.data.author_name)}`} class="bg-white border border-gray-200 rounded-xl p-3 text-center hover:border-violet-300 transition-colors">
          <div class="text-xs text-gray-400 mb-1">著者</div>
          <div class="text-sm font-medium text-gray-900">{entry.data.author_name}</div>
        </a>
        <a href={`/publishers/${encodeURIComponent(entry.data.publisher)}`} class="bg-white border border-gray-200 rounded-xl p-3 text-center hover:border-violet-300 transition-colors">
          <div class="text-xs text-gray-400 mb-1">出版社</div>
          <div class="text-sm font-medium text-gray-900">{entry.data.publisher}</div>
        </a>
        <div class="bg-white border border-gray-200 rounded-xl p-3 text-center">
          <div class="text-xs text-gray-400 mb-1">期待値</div>
          <div class="flex items-center justify-center gap-1">
            <div>
              {[1,2,3,4,5].map((i) => (
                <span class={i <= entry.data.expectation_score ? "text-amber-400" : "text-gray-200"}>★</span>
              ))}
            </div>
            <span class="text-xs font-medium text-gray-500">{entry.data.expectation_score}/5</span>
          </div>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl p-3 text-center">
          <div class="text-xs text-gray-400 mb-1">発売日</div>
          <div class="text-sm font-medium text-gray-900">{entry.data.pubDate}</div>
        </div>
      </div>
    </header>

    <!-- Tags -->
    {entry.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8">
        {entry.data.tags.map((tag: string) => (
          <a
            href={`/tags/${encodeURIComponent(tag)}`}
            class="text-xs bg-gray-100 text-gray-500 hover:bg-violet-100 hover:text-violet-600 px-2.5 py-1 rounded-full transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}

    <!-- Content -->
    <article class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-600 prose-a:text-violet-600 prose-strong:text-gray-900">
      <Content />
    </article>

    <!-- こんな方におすすめ -->
    {finalRecommendations.length > 0 && (
      <section class="mt-10 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-2xl p-5 sm:p-6">
        <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-4 flex items-center gap-2">
          <span class="w-1.5 h-5 bg-gradient-to-b from-amber-400 to-orange-500 rounded-full"></span>
          こんな方におすすめ
        </h2>
        <ul class="grid sm:grid-cols-2 gap-2">
          {finalRecommendations.map((rec) => (
            <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-gray-300">
              <span class="text-amber-400 shrink-0 mt-0.5">✓</span>
              {rec}
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Store Comparison -->
    <div class="mt-12 p-5 sm:p-8 bg-gradient-to-br from-violet-50 to-pink-50 border border-violet-200 rounded-2xl">
      <p class="text-lg font-bold text-gray-900 mb-4 text-center">この作品を購入する</p>
      <div class="grid sm:grid-cols-2 gap-3">
        <a href={entry.data.affiliate_url} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between bg-white border border-gray-200 rounded-xl p-4 hover:border-amber-300 hover:shadow-md transition-all group">
          <div>
            <div class="font-bold text-gray-900 group-hover:text-amber-600 transition-colors">Amazon</div>
            <div class="text-xs text-gray-400">Kindleストア</div>
          </div>
          <span class="text-xs font-medium bg-amber-100 text-amber-700 px-3 py-1 rounded-full">チェック →</span>
        </a>
        <a href="https://ebookjapan.yahoo.co.jp/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between bg-white border border-gray-200 rounded-xl p-4 hover:border-rose-300 hover:shadow-md transition-all group">
          <div>
            <div class="font-bold text-gray-900 group-hover:text-rose-600 transition-colors">ebookjapan</div>
            <div class="text-xs text-gray-400">初回70%OFFクーポンあり</div>
          </div>
          <span class="text-xs font-medium bg-rose-100 text-rose-700 px-3 py-1 rounded-full">チェック →</span>
        </a>
        <a href="https://booklive.jp/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between bg-white border border-gray-200 rounded-xl p-4 hover:border-blue-300 hover:shadow-md transition-all group">
          <div>
            <div class="font-bold text-gray-900 group-hover:text-blue-600 transition-colors">BookLive</div>
            <div class="text-xs text-gray-400">クーポン多数</div>
          </div>
          <span class="text-xs font-medium bg-blue-100 text-blue-700 px-3 py-1 rounded-full">チェック →</span>
        </a>
        <a href="https://www.cmoa.jp/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between bg-white border border-gray-200 rounded-xl p-4 hover:border-green-300 hover:shadow-md transition-all group">
          <div>
            <div class="font-bold text-gray-900 group-hover:text-green-600 transition-colors">コミックシーモア</div>
            <div class="text-xs text-gray-400">読み放題プランあり</div>
          </div>
          <span class="text-xs font-medium bg-green-100 text-green-700 px-3 py-1 rounded-full">チェック →</span>
        </a>
      </div>
      {entry.data.stores && entry.data.stores.length > 0 && (
        <div class="mt-4 pt-4 border-t border-violet-100">
          {entry.data.stores.map((store) => (
            <a href={store.url} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between text-sm py-2">
              <span class="text-gray-600">{store.name}</span>
              {store.price && <span class="font-bold text-rose-600">{store.price}</span>}
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- SNS Share -->
    <div class="mt-8 flex items-center justify-center gap-3">
      <span class="text-sm text-gray-400">シェア:</span>
      <a
        href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(pageUrl)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 bg-black text-white text-xs font-medium px-4 py-2 rounded-full hover:bg-gray-800 transition-colors"
      >
        𝕏 ポスト
      </a>
      <a
        href={`https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(pageUrl)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 bg-green-500 text-white text-xs font-medium px-4 py-2 rounded-full hover:bg-green-600 transition-colors"
      >
        LINE
      </a>
    </div>

    <!-- Related Works -->
    {related.length > 0 && (
      <section class="mt-12">
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
          <span class="w-1.5 h-5 bg-gradient-to-b from-violet-500 to-pink-500 rounded-full"></span>
          関連作品
        </h2>
        <div class="grid sm:grid-cols-2 gap-3">
          {related.map((m) => (
            <a
              href={`/manga/${m.slug}`}
              class="group flex gap-3 bg-white border border-gray-200 rounded-xl p-3 hover:border-violet-300 hover:shadow-md transition-all"
            >
              {m.data.cover_image && (
                <img src={m.data.cover_image} alt={m.data.title} class="w-12 h-16 object-cover rounded-lg shrink-0" loading="lazy" />
              )}
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-1.5 mb-1">
                  <span class="text-xs bg-violet-50 text-violet-600 px-1.5 py-0.5 rounded">{m.data.genre}</span>
                  <span class="text-xs text-gray-400">{m.data.pubDate}</span>
                </div>
                <h3 class="font-bold text-sm text-gray-900 group-hover:text-violet-600 transition-colors truncate">{m.data.title}</h3>
                <p class="text-xs text-gray-400 truncate">{m.data.author_name}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>

  <style>
    .bookmark-btn.active { color: rgb(244 63 94); }
    .status-btn.active {
      background: rgb(237 233 254);
      border-color: rgb(167 139 250);
      color: rgb(109 40 217);
    }
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      // Bookmark
      const bookmarkBtn = document.querySelector<HTMLButtonElement>(".bookmark-btn");
      if (bookmarkBtn) {
        const slug = bookmarkBtn.dataset.slug!;
        const title = bookmarkBtn.dataset.title!;
        const bookmarks: Record<string, string> = JSON.parse(localStorage.getItem("manga-bookmarks") || "{}");

        if (bookmarks[slug]) bookmarkBtn.classList.add("active");

        bookmarkBtn.addEventListener("click", () => {
          const current: Record<string, string> = JSON.parse(localStorage.getItem("manga-bookmarks") || "{}");
          if (current[slug]) {
            delete current[slug];
            bookmarkBtn.classList.remove("active");
          } else {
            current[slug] = title;
            bookmarkBtn.classList.add("active");
          }
          localStorage.setItem("manga-bookmarks", JSON.stringify(current));
        });
      }

      // Reading status
      const statusContainer = document.getElementById("reading-status");
      if (statusContainer) {
        const slug = statusContainer.dataset.slug!;
        const buttons = statusContainer.querySelectorAll<HTMLButtonElement>(".status-btn");
        const statuses: Record<string, string> = JSON.parse(localStorage.getItem("manga-status") || "{}");

        buttons.forEach((btn) => {
          if (statuses[slug] === btn.dataset.status) btn.classList.add("active");
          btn.addEventListener("click", () => {
            const current: Record<string, string> = JSON.parse(localStorage.getItem("manga-status") || "{}");
            buttons.forEach((b) => b.classList.remove("active"));
            if (current[slug] === btn.dataset.status) {
              delete current[slug];
            } else {
              current[slug] = btn.dataset.status!;
              btn.classList.add("active");
            }
            localStorage.setItem("manga-status", JSON.stringify(current));
          });
        });
      }
    });
  </script>
</BaseLayout>
