---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const salesEntries = await getCollection("sales");
  return salesEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const now = new Date();
const isActive = entry.data.is_active && new Date(entry.data.end_date) >= now;

const saleTypeStyle = (type: string) => {
  switch (type) {
    case "割引": return "bg-rose-100 text-rose-700 border-rose-200";
    case "ポイント還元": return "bg-blue-100 text-blue-700 border-blue-200";
    case "無料": return "bg-green-100 text-green-700 border-green-200";
    case "クーポン": return "bg-amber-100 text-amber-700 border-amber-200";
    case "キャンペーン": return "bg-violet-100 text-violet-700 border-violet-200";
    default: return "bg-gray-100 text-gray-600 border-gray-200";
  }
};

const saleTypeIcon = (type: string) => {
  switch (type) {
    case "割引": return "🏷️";
    case "ポイント還元": return "💰";
    case "無料": return "🆓";
    case "クーポン": return "🎟️";
    case "キャンペーン": return "🎉";
    default: return "📢";
  }
};

// 関連する漫画記事を取得
const allManga = await getCollection("manga");
const relatedManga = allManga.filter((m) =>
  entry.data.featured_titles.some((t) => m.data.series === t || m.data.title.includes(t))
);
---

<BaseLayout title={`${entry.data.title} | 漫画新刊まとめ`}>
  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <a href="/sales" class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-violet-600 transition-colors mb-8">
      <span>←</span> セール一覧に戻る
    </a>

    <!-- Header -->
    <header class="mb-10">
      <div class="flex items-center gap-2 mb-4 flex-wrap">
        <span class={`text-xs font-medium border px-2.5 py-1 rounded-full ${saleTypeStyle(entry.data.sale_type)}`}>
          {saleTypeIcon(entry.data.sale_type)} {entry.data.sale_type}
        </span>
        {isActive ? (
          <span class="text-xs font-medium bg-green-100 text-green-700 border border-green-200 px-2.5 py-1 rounded-full">
            開催中
          </span>
        ) : (
          <span class="text-xs font-medium bg-gray-100 text-gray-500 border border-gray-200 px-2.5 py-1 rounded-full">
            終了
          </span>
        )}
        <span class="text-xs text-gray-400">{entry.data.store}</span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-bold mb-4 bg-gradient-to-r from-violet-600 to-pink-600 bg-clip-text text-transparent">
        {entry.data.title}
      </h1>

      <p class="text-gray-500 mb-6">{entry.data.description}</p>

      <!-- Sale Info Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        <div class="bg-white border border-gray-200 rounded-xl p-3 text-center">
          <div class="text-xs text-gray-400 mb-1">割引内容</div>
          <div class="text-sm font-bold text-rose-600">{entry.data.discount_text}</div>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl p-3 text-center">
          <div class="text-xs text-gray-400 mb-1">開始日</div>
          <div class="text-sm font-medium text-gray-900">{entry.data.start_date}</div>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl p-3 text-center">
          <div class="text-xs text-gray-400 mb-1">終了日</div>
          <div class="text-sm font-medium text-gray-900">{entry.data.end_date}</div>
        </div>
      </div>

      {/* 対象ジャンル */}
      <div class="flex items-center gap-2 mt-4 flex-wrap">
        <span class="text-xs text-gray-400">対象ジャンル:</span>
        {entry.data.target_genres.map((genre) => (
          <span class="text-xs bg-violet-50 text-violet-600 border border-violet-100 px-2 py-0.5 rounded-full">
            {genre}
          </span>
        ))}
      </div>
    </header>

    <!-- Content -->
    <article class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-600 prose-a:text-violet-600 prose-strong:text-gray-900 mb-10">
      <Content />
    </article>

    {/* 関連する漫画記事 */}
    {relatedManga.length > 0 && (
      <section class="mb-10">
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
          <span class="w-1.5 h-5 bg-gradient-to-b from-violet-500 to-pink-500 rounded-full"></span>
          関連する漫画レビュー
        </h2>
        <div class="space-y-3">
          {relatedManga.map((manga) => (
            <a
              href={`/manga/${manga.slug}`}
              class="group flex items-center gap-3 bg-white border border-gray-200 rounded-xl p-3 hover:border-violet-300 hover:shadow-md transition-all"
            >
              {manga.data.cover_image && (
                <img
                  src={manga.data.cover_image}
                  alt={manga.data.title}
                  class="w-10 h-14 object-cover rounded-lg shrink-0"
                />
              )}
              <div class="flex-1 min-w-0">
                <h3 class="font-bold text-sm text-gray-900 group-hover:text-violet-600 transition-colors truncate">
                  {manga.data.title}
                </h3>
                <p class="text-xs text-gray-400">{manga.data.author_name}</p>
              </div>
              <span class="text-xs text-gray-400 group-hover:text-violet-500 shrink-0">→</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- CTA -->
    {isActive && (
      <div class="p-5 sm:p-8 bg-gradient-to-br from-violet-50 to-pink-50 border border-violet-200 rounded-2xl text-center">
        <p class="text-lg font-bold text-gray-900 mb-2">このセールをチェック</p>
        <p class="text-sm text-gray-500 mb-5">{entry.data.store}でお得に購入</p>
        <a
          href={entry.data.sale_url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-gradient-to-r from-rose-500 to-orange-500 hover:from-rose-400 hover:to-orange-400 text-white font-bold px-8 py-3 rounded-xl transition-all duration-300 shadow-lg shadow-rose-200 hover:shadow-rose-300"
        >
          {entry.data.store}で見る
        </a>
      </div>
    )}
  </main>
</BaseLayout>
