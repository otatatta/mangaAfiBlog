---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const allSales = await getCollection("sales");

const now = new Date();
const active = allSales
  .filter((s) => s.data.is_active && new Date(s.data.end_date) >= now)
  .sort((a, b) => new Date(b.data.start_date).getTime() - new Date(a.data.start_date).getTime());

const expired = allSales
  .filter((s) => !s.data.is_active || new Date(s.data.end_date) < now)
  .sort((a, b) => new Date(b.data.end_date).getTime() - new Date(a.data.end_date).getTime());

const saleTypeStyle = (type: string) => {
  switch (type) {
    case "割引": return "bg-rose-100 text-rose-700 border-rose-200";
    case "ポイント還元": return "bg-blue-100 text-blue-700 border-blue-200";
    case "無料": return "bg-green-100 text-green-700 border-green-200";
    case "クーポン": return "bg-amber-100 text-amber-700 border-amber-200";
    case "キャンペーン": return "bg-violet-100 text-violet-700 border-violet-200";
    default: return "bg-gray-100 text-gray-600 border-gray-200";
  }
};

const saleTypeIcon = (type: string) => {
  switch (type) {
    case "割引": return "🏷️";
    case "ポイント還元": return "💰";
    case "無料": return "🆓";
    case "クーポン": return "🎟️";
    case "キャンペーン": return "🎉";
    default: return "📢";
  }
};

const daysRemaining = (endDate: string) => {
  const diff = new Date(endDate).getTime() - now.getTime();
  const days = Math.ceil(diff / (1000 * 60 * 60 * 24));
  if (days <= 0) return null;
  if (days <= 3) return { text: `残り${days}日`, urgent: true };
  return { text: `残り${days}日`, urgent: false };
};
---

<BaseLayout title="セール・キャンペーン | 漫画新刊まとめ">
  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <section class="text-center mb-10 sm:mb-16">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 bg-gradient-to-r from-violet-600 via-pink-600 to-orange-500 bg-clip-text text-transparent">
        セール・キャンペーン
      </h1>
      <p class="text-gray-500 text-base sm:text-lg">ebookjapanのお得な情報をまとめてチェック</p>
    </section>

    {/* 開催中 */}
    {active.length > 0 && (
      <section class="mb-12">
        <h2 class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
          <span class="w-2 h-6 bg-gradient-to-b from-violet-500 to-pink-500 rounded-full"></span>
          開催中のセール
        </h2>
        <div class="space-y-4">
          {active.map((sale) => {
            const remaining = daysRemaining(sale.data.end_date);
            return (
              <a
                href={`/sales/${sale.slug}`}
                class="group block bg-white border border-gray-200 rounded-xl sm:rounded-2xl p-4 sm:p-6 hover:border-violet-300 hover:shadow-lg hover:shadow-violet-100/50 transition-all duration-300"
              >
                <div class="flex items-start gap-4">
                  <div class="text-3xl sm:text-4xl shrink-0">
                    {saleTypeIcon(sale.data.sale_type)}
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-2 flex-wrap">
                      <span class={`text-xs font-medium border px-2.5 py-1 rounded-full ${saleTypeStyle(sale.data.sale_type)}`}>
                        {sale.data.sale_type}
                      </span>
                      <span class="text-xs font-bold bg-gradient-to-r from-rose-500 to-orange-500 text-white px-3 py-1 rounded-full">
                        {sale.data.discount_text}
                      </span>
                      {remaining && (
                        <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${remaining.urgent ? "bg-rose-100 text-rose-700 animate-pulse" : "bg-gray-100 text-gray-500"}`}>
                          {remaining.text}
                        </span>
                      )}
                    </div>

                    <h3 class="text-lg font-bold text-gray-900 group-hover:text-violet-600 transition-colors mb-1">
                      {sale.data.title}
                    </h3>

                    <p class="text-gray-500 text-sm mb-3 line-clamp-2">
                      {sale.data.description}
                    </p>

                    <div class="flex items-center justify-between flex-wrap gap-2">
                      <div class="flex items-center gap-2 flex-wrap">
                        {sale.data.target_genres.map((genre) => (
                          <span class="text-xs bg-violet-50 text-violet-600 px-2 py-0.5 rounded">
                            {genre}
                          </span>
                        ))}
                      </div>
                      <div class="text-xs text-gray-400">
                        {sale.data.start_date} 〜 {sale.data.end_date}
                      </div>
                    </div>

                    {sale.data.featured_titles.length > 0 && (
                      <div class="mt-3 pt-3 border-t border-gray-100">
                        <span class="text-xs text-gray-400">対象作品: </span>
                        <span class="text-xs text-gray-600">
                          {sale.data.featured_titles.join("、")}
                        </span>
                      </div>
                    )}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {/* 終了済み */}
    {expired.length > 0 && (
      <section>
        <h2 class="text-xl font-bold text-gray-400 mb-6 flex items-center gap-2">
          <span class="w-2 h-6 bg-gray-300 rounded-full"></span>
          終了したセール
        </h2>
        <div class="space-y-3 opacity-60">
          {expired.map((sale) => (
            <a
              href={`/sales/${sale.slug}`}
              class="group block bg-white border border-gray-200 rounded-xl p-4 hover:border-gray-300 transition-all"
            >
              <div class="flex items-center gap-3">
                <span class="text-2xl shrink-0">{saleTypeIcon(sale.data.sale_type)}</span>
                <div class="flex-1 min-w-0">
                  <h3 class="font-bold text-gray-500 group-hover:text-gray-700 transition-colors truncate">
                    {sale.data.title}
                  </h3>
                  <p class="text-xs text-gray-400">
                    {sale.data.start_date} 〜 {sale.data.end_date} | {sale.data.discount_text}
                  </p>
                </div>
                <span class="text-xs bg-gray-100 text-gray-400 px-2 py-1 rounded-full shrink-0">終了</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {active.length === 0 && expired.length === 0 && (
      <div class="text-center py-20">
        <div class="text-6xl mb-4">🏷️</div>
        <p class="text-gray-500 text-lg">現在セール情報はありません</p>
        <p class="text-gray-400 text-sm mt-2">新しいセール情報が入り次第更新します</p>
      </div>
    )}
  </main>
</BaseLayout>
